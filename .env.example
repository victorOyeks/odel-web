# Where the Spring Boot API listens. Next.js proxies /api/* here.
ODEL_API_URL=http://localhost:8080

# 1 = serve typed fixtures instead of calling the API (no backend needed).
# Never set this in production.
ODEL_MOCK_API=0

# Mock mode only: "demo" seeds two universities, "empty" starts with none.
ODEL_MOCK_SEED=demo
